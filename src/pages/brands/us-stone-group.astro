---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DealerCTA from '../../components/DealerCTA.astro';
const schema = {"@context":"https://schema.org","@type":"Product","name":"US Stone Group Luxury Surfaces","brand":{"@type":"Brand","name":"US Stone Group"},"description":"Luxury natural stone, semi-precious gemstone, and large-format porcelain slabs — including the signature Cristallo and Patagonia quartzite lines — distributed by Pinnacle Sales across the Western U.S.","category":"Natural Stone & Surface Slabs","manufacturer":{"@type":"Organization","name":"US Stone Group","url":"https://usstonegroup.com"},"offers":{"@type":"Offer","availability":"https://schema.org/InStock","seller":{"@type":"Organization","name":"Pinnacle Sales","url":"https://www.pinnaclesales.biz"},"areaServed":["Arizona","California","Colorado","Idaho","Montana","Nevada","New Mexico","Oregon","Utah","Washington"]},"audience":{"@type":"BusinessAudience","name":"Kitchen and bath dealers, designers, and fabricators"}};
---
<BaseLayout title="US Stone Group — Luxury Stone & Surfaces | Pinnacle Sales" description="Pinnacle Sales distributes US Stone Group luxury surfaces — Cristallo & Patagonia quartzite, semi-precious gemstone, marble, and Italian porcelain slabs across the Western U.S." schema={schema} ogImage="/images/brands/us-stone-group/cristallo.webp">
<div class="page-header"><h1>US Stone Group — Exclusive Luxury Surfaces</h1><p>The Language of Luxury. Natural stone, semi-precious gemstone, and large-format porcelain slabs — now distributed across the West by Pinnacle Sales.</p></div>
<div class="content-narrow section">
<Breadcrumbs items={[{name:'Home',href:'/'},{name:'Brands',href:'/#brands'},{name:'US Stone Group'}]} />

<p>Pinnacle Sales is proud to bring <strong>US Stone Group</strong> to dealers, designers, and fabricators across the Western U.S. Based in Westminster, California, US Stone Group is a luxury stone and surface supplier that hand-selects premium natural stone, porcelain, and semi-precious gemstone slabs from the world's finest quarries. With this partnership, Pinnacle now represents the surface as well as the cabinetry — a single source for the whole kitchen and bath.</p>

<div class="slab-hero">
  <img src="/images/brands/us-stone-group/cristallo.webp" alt="Cristallo quartzite slab — crystalline, translucent, backlight-ready" width="1600" height="1200" loading="eager" />
</div>

<h2>Why US Stone Group</h2>
<ul>
  <li><strong>Curated luxury inventory</strong> — rare, visually distinctive materials, not commodity stone, with a large ready-to-ship supply of the trending Cristallo and Patagonia slabs.</li>
  <li><strong>Quarry-direct access</strong> — deep, direct relationships with the owners of the Cristallo and Patagonia quartzite quarries and mines.</li>
  <li><strong>Global sourcing network</strong> — twenty years of relationships across the world's premier stone-producing regions.</li>
  <li><strong>Quality you can trust</strong> — every slab is inspected before loading, with any significant cracks or damage disclosed up front.</li>
  <li><strong>Personalized service</strong> — FaceTime walk-throughs, additional photos, and inventory verification on request.</li>
</ul>

<h2>Signature Collections</h2>
<p>From bold statement quartzites to luminous semi-precious gemstone slabs, US Stone Group's collections are curated for unmatched style and premium quality across three categories.</p>

<div class="collection">
  <h3>Natural Stone</h3>
  <p>Quartzite, marble, granite, and travertine — including the signature <strong>Cristallo</strong> (Bianco, Rosa, Gold, Royale, Slate, Smoke, Mist, Sol &amp; Lumix) and <strong>Patagonia</strong> (Select, Ivory &amp; Eclipse) lines, plus timeless quartzites like Taj Mahal, Mont Blanc, Perla Venata, and Emerald. Available in 2 cm and 3 cm.</p>
  <div class="slab-grid">
    <figure><img src="/images/brands/us-stone-group/patagonia.webp" alt="Patagonia quartzite book-matched slab" width="1600" height="1200" loading="lazy" /><figcaption>Patagonia Quartzite</figcaption></figure>
    <figure><img src="/images/brands/us-stone-group/emerald.webp" alt="Emerald quartzite book-matched slab" width="1600" height="1200" loading="lazy" /><figcaption>Emerald Quartzite</figcaption></figure>
    <figure><img src="/images/brands/us-stone-group/marble.webp" alt="Luxury marble slab" width="1000" height="1495" loading="lazy" /><figcaption>Marble</figcaption></figure>
  </div>
</div>

<div class="collection">
  <h3>Semi-Precious</h3>
  <p>Agate, amethyst, crystal quartz, sodalite, and decorative mineral slabs — striking, one-of-a-kind feature surfaces. Many are translucent and backlight-ready for dramatic islands, bar tops, and feature walls.</p>
  <div class="slab-grid">
    <figure><img src="/images/brands/us-stone-group/agate-backlit.webp" alt="Backlit agate slab feature application" width="300" height="195" loading="lazy" /><figcaption>Backlit Agate</figcaption></figure>
    <figure><img src="/images/brands/us-stone-group/blue-agate.webp" alt="Blue agate semi-precious slab" width="1600" height="1200" loading="lazy" /><figcaption>Blue Agate</figcaption></figure>
    <figure><img src="/images/brands/us-stone-group/crystal-quartz.webp" alt="Crystal quartz semi-precious slab" width="1600" height="1200" loading="lazy" /><figcaption>Crystal Quartz</figcaption></figure>
  </div>
</div>

<div class="collection">
  <h3>Porcelain</h3>
  <p>Large-format Italian porcelain in marble, stone, and travertine looks — durable, low-maintenance surfaces for floors, walls, and counters, including book-matched and full-slab applications.</p>
</div>

<h2>Applications</h2>
<p>US Stone Group surfaces are specified for kitchen countertops, bathroom vanities, feature walls, fireplace surrounds, flooring, hospitality and commercial interiors, and custom furniture surfaces.</p>
<div class="slab-grid">
  <figure><img src="/images/brands/us-stone-group/application-kitchen.webp" alt="Luxury stone countertop kitchen application" width="1536" height="1185" loading="lazy" /><figcaption>Kitchen Countertops</figcaption></figure>
  <figure><img src="/images/brands/us-stone-group/application-feature.webp" alt="Luxury stone feature wall application" width="1536" height="1094" loading="lazy" /><figcaption>Feature Walls</figcaption></figure>
</div>

<h2>See the Slabs in Person</h2>
<p>Selecting natural stone is a visual, slab-by-slab decision — no two pieces are alike. Tell us about your project and Pinnacle Sales will connect you with current inventory, additional photos, and a slab walk-through, then route you to a local dealer or fabricator to complete your selection.</p>
<p><a class="btn btn-outline" href="/contact">Request a Slab Walk-Through</a></p>

<DealerCTA heading="Add Luxury Surfaces to Your Showroom" text="Now distributed by Pinnacle Sales across the Western U.S., US Stone Group lets your dealership offer the countertop alongside the cabinetry — backed by the same hands-on rep support. Contact us to carry US Stone Group." />
</div>
</BaseLayout>
<style>
  .slab-hero {
    margin: 1.5rem 0 2rem;
  }
  .slab-hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.12);
  }
  .collection {
    background: var(--color-bg-alt);
    border-left: 3px solid var(--color-accent);
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
    border-radius: 0 6px 6px 0;
  }
  .collection h3 { margin-top: 0; }
  .slab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.25rem;
    margin: 1.25rem 0 0.25rem;
  }
  .slab-grid figure { margin: 0; }
  .slab-grid img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
  }
  .slab-grid figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-muted);
    text-transform: uppercase;
  }
</style>
