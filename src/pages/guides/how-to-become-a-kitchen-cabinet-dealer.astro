import { WW_STATE_NAMES, WW_STATE_COUNT_WORD, BRAND_SHORT_NAMES } from '../../data/footprint';

const faqs = [
  { q: 'How do I become a kitchen cabinet dealer with Pinnacle Sales?', a: "Submit the application on <a href='/become-a-dealer/'>Become a Dealer</a>. Check the lines you want — starting with Shiloh alone is common. A Pinnacle Sales rep calls the same business day (next business morning after 3 pm Pacific)." },
  { q: 'We build custom, or we used to sell Kraftmaid / Medallion. Can we open Shiloh only?', a: "Yes. That is a common application. Read <a href='/guides/become-a-shiloh-dealer/'>become a Shiloh dealer</a>, then apply. Tell us what you build now and what you used to carry." },
  { q: 'What brands can I carry?', a: `${BRAND_SHORT_NAMES}. You don't have to take every line.` },
  { q: 'Is there a fee to apply?', a: 'No fee to apply or to become an authorized dealer. Display commitments and minimums vary by brand and program. We walk those on the intro call.' },
  { q: 'Which states does Pinnacle cover?', a: `WW Wood Products lines — Shiloh, Eclipse, Aspect, Vistora — across ${WW_STATE_NAMES}. Pronorm German Kitchens are available to qualified dealers nationwide.` },
