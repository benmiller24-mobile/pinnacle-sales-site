---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DealerCTA from '../../components/DealerCTA.astro';
import { projects } from '../../data/projects';
const stateProjects = projects.filter(p => p.state === 'Nevada');
const breadcrumbs = [{name:'Home',href:'/'},{name:'Territory'},{name:'Nevada'}];
const serviceSchema = {"@context":"https://schema.org","@type":"Service","name":"Kitchen Cabinet Dealer Representation — Nevada","provider":{"@type":"Organization","name":"Pinnacle Sales","url":"https://www.pinnaclesales.biz"},"areaServed":{"@type":"State","name":"Nevada"},"serviceType":"Manufacturer's Representative","description":"Pinnacle Sales connects Nevada kitchen and bath dealers with Shiloh, Eclipse, Aspect, Pronorm, and Vistora cabinetry brands."};
---
<BaseLayout title="Nevada Kitchen Cabinet Rep — Shiloh, Eclipse & Pronorm Dealers" description="Pinnacle Sales connects Nevada kitchen dealers — Las Vegas, Reno, Henderson — with Shiloh, Eclipse, Pronorm & Vistora. Hands-on training, design support, territory protection." schema={serviceSchema}>
<div class="page-header"><h1>Kitchen & Bath Cabinetry Dealer Support in Nevada</h1><p>Premium brands, hands-on support, and local market expertise for Nevada kitchen dealers.</p></div>
<div class="content-narrow section">
<Breadcrumbs items={breadcrumbs} />

<p>Pinnacle Sales serves kitchen and bath dealers across Nevada with five premium cabinetry brands and dedicated local support. Our team brings 23+ years of industry expertise to help your dealership grow in Las Vegas, Henderson, Reno, Sparks, and the Lake Tahoe region.</p>

<h2>Available Brands in Nevada</h2>
<ul>
<li><a href="/brands/shiloh-cabinetry">Shiloh Cabinetry</a> — American-made face-frame, inset, and custom paint</li>
<li><a href="/brands/eclipse-cabinetry">Eclipse Cabinetry</a> — Modern frameless full-access construction</li>
<li><a href="/brands/aspect-cabinetry">Aspect Cabinetry</a> — Value-driven semi-custom for builders and budget-conscious clients</li>
<li><a href="/brands/pronorm-german-kitchens">Pronorm German Kitchens</a> — Premium European fitted kitchens</li>
<li><a href="/brands/vistora-closets">Vistora Closets</a> — Made-to-order closet and storage solutions by WW Wood Products</li>
</ul>


<h2>Nevada Kitchen Design Trends</h2>
<p>Nevada's kitchen market is driven by Las Vegas's dynamic residential construction and remodeling sector. The Vegas metro — including Henderson and Summerlin — favors bold contemporary design with high-gloss finishes, dramatic islands, and modern frameless cabinetry. <a href="/brands/eclipse-cabinetry">Eclipse Cabinetry</a> is a strong performer in this market with its sleek full-access construction and wide finish palette.</p>
<p>Northern Nevada's Reno-Sparks corridor and Lake Tahoe area support a different aesthetic — mountain-transitional with warm woods, painted combinations, and rustic accents. The state's active builder market, particularly in planned communities, creates volume opportunities for <a href="/brands/aspect-cabinetry">Aspect Cabinetry's</a> value-driven semi-custom platform.</p>


<h2>Local Dealer Support</h2>
<p>Pinnacle Sales serves Nevada dealers across both the Las Vegas and Reno-Tahoe markets. Our team provides in-person showroom visits, builder specification support, and design training tailored to each region's distinct market dynamics.</p>

{stateProjects.length > 0 && (
<>
<h2>Recent Projects in Nevada</h2>
<p>Real installs by Pinnacle Sales dealer partners in Nevada. See the full <a href="/projects">project gallery</a> for more.</p>
<div class="state-projects">
  {stateProjects.map((p) => (
    <a href={`/projects/${p.slug}`} class="state-project-card">
      <div class="state-project-image">
        <img src={`/images/projects/${p.slug}/${p.hero}`} alt={p.title} loading="lazy" width="600" height="400" />
        <span class="state-project-brand">{p.brand}</span>
      </div>
      <div class="state-project-body">
        <h3>{p.title}</h3>
        <p class="state-project-meta">{p.dealer} &middot; {p.location}</p>
      </div>
    </a>
  ))}
</div>
</>
)}

<h2>Dealer Support Services in Nevada</h2>
<ul>
<li><strong>In-person sales training</strong> — Product knowledge, competitive positioning, and closing strategies in your showroom</li>
<li><strong>2020/Winner design and quoting support</strong> — Help with complex projects and multi-brand specifications</li>
<li><strong>Showroom merchandising</strong> — Display planning, sample programs, and vignette design</li>
<li><strong>Marketing resources</strong> — Co-branded content, photography, and project showcases</li>
<li><strong>Factory coordination</strong> — Tours, technical consultations, and custom project support with WW Wood Products and Pronorm</li>
<li><strong>Technical support</strong> — Order management, specification questions, and installation guidance</li>
</ul>

<h2>Resources for Nevada Dealers</h2>
<p>Visit the <a href="/playbook">Kitchen Dealer Playbook</a> for articles on product knowledge, design trends, and business development strategies. Featured articles include:</p>
<ul>
<li><a href="/playbook/frameless-vs-face-frame-cabinets">Frameless vs Face-Frame Cabinets</a> — Help clients choose the right construction method</li>
<li><a href="/playbook/modern-inset">Modern Inset: 6 No-Upcharge Variations from Shiloh</a> — Expand your inset cabinetry offerings</li>
<li><a href="/playbook/japan-inspired-kitchens">Japan-Inspired Kitchens</a> — Spec the warm minimalism trend at three price points</li>
</ul>

<DealerCTA heading="Become a Dealer in Nevada" text="Ready to partner with the leading cabinetry rep firm in Nevada? Let us know about your showroom and market." />
</div>

<style>
  .state-projects {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
    margin: 1.25rem 0 2rem;
  }
  .state-project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border, #e0e0e0);
    background: #fff;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .state-project-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0,0,0,0.08);
    opacity: 1;
  }
  .state-project-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-alt, #f7f7f7);
  }
  .state-project-image img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .state-project-brand {
    position: absolute;
    bottom: 0.5rem; left: 0.5rem;
    background: rgba(0,0,0,0.75); color: #fff;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
  }
  .state-project-body { padding: 0.9rem 1rem 1.1rem; }
  .state-project-body h3 {
    font-size: 0.98rem;
    line-height: 1.3;
    font-weight: 500;
    margin: 0 0 0.3rem;
  }
  .state-project-meta {
    font-size: 0.78rem;
    color: var(--color-light-text, #999);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0;
  }
</style>
</BaseLayout>
