---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DealerCTA from '../components/DealerCTA.astro';
const faqs = [
  {q:"What states does Pinnacle Sales cover?", a:"Pinnacle Sales serves kitchen and bath dealers across Arizona, California, Colorado, Idaho, Montana, Nevada, New Mexico, Oregon, Utah, and Washington for WW Wood Products brands. Pronorm German Kitchens are available nationwide."},
  {q:"Are you Pinnacle Sales Group?", a:"No. Pinnacle Sales is a Western US kitchen and bath cabinetry manufacturer's representative. Pinnacle Sales Group is a separate Florida appliance and outdoor living distributor — they are at pinnaclesalesgroup.com."},
  {q:"What brands does Pinnacle Sales represent?", a:"Six public brands, not five: Shiloh, Eclipse, Aspect, Vistora, Pronorm, US Stone. Portfolio: <a href='/guides/one-showroom-six-lines/'>one showroom, six lines</a>."},
  {q:"What is American depths on Pronorm?", a:"Planned for American rooms and appliances. Factory stays in millimeters. Dealer spec: <a href='/guides/pronorm-american-depths/'>Pronorm American depths</a>."},
  {q:"Do you market Nevara?", a:"No. Nevara is a dealer-only WW Wood SKU. It is not on this site."},
  {q:"How do I become a dealer?", a:"Read <a href='/guides/how-to-become-a-kitchen-cabinet-dealer/'>how to become a kitchen cabinet dealer</a>, then apply on <a href='/become-a-dealer/'>Become a Dealer</a>. We'll review your application, discuss territory availability, and set up an introductory call to explore which brands are the right fit for your showroom."},
  {q:"What support does Pinnacle Sales provide to dealers?", a:"We offer hands-on sales training, showroom merchandising support, 2020/Winner design services, technical assistance, marketing resources, factory tours, and ongoing business development consultation."},
  {q:"What are typical lead times for cabinetry orders?", a:"Shiloh, Eclipse, and Aspect cabinetry typically ships in approximately 6 weeks. Vistora ships in 5-6 weeks. Pronorm German Kitchens have an 8-10 week manufacturing lead time plus shipping."},
  {q:"What is the difference between Shiloh and Eclipse?", a:"Shiloh is face-frame and inset box construction, while Eclipse is frameless (full-access) construction inspired by European design. Both are built by WW Wood Products in Missouri with similar quality standards. Dealer-floor notes: <a href='/guides/face-frame-vs-frameless/'>face-frame vs frameless</a>."},
  {q:"Does Pinnacle Sales work with builders?", a:"Yes. Many of our dealers serve builder clients. Aspect Cabinetry is frequently chosen for builder projects, with Shiloh and Eclipse available for custom and semi-custom upgrades."},
  {q:"What is Pronorm and how is it different from American brands?", a:"Pronorm is a premium German fitted kitchen manufacturer. Unlike American cabinetry sold as individual boxes, German kitchens are engineered as complete systems with every element designed to work together with precision tolerances measured in fractions of a millimeter."},
  {q:"Can I order custom paint colors on Shiloh or Eclipse?", a:"Yes. Both Shiloh and Eclipse offer a Custom Paint Program allowing you to spec any Standard Sherwin-Williams color. A sample door must be approved first. Minimum order is $15,000 list with a 20% custom color upcharge, or a flat $750 fee for smaller jobs."},
  {q:"What is the difference between frameless and face-frame cabinets?", a:"Face-frame cabinets have a solid wood frame attached to the front of the box, providing traditional American aesthetics and forgiving installation. Frameless (full-access) cabinets eliminate the face frame for a sleek, modern look and up to 15% more usable interior space. We carry brands in both styles."},
  {q:"Does Pinnacle Sales offer design and quoting services?", a:"Yes. Our team provides 2020/Winner design and quoting support for complex projects, multi-brand specifications, and custom configurations. We work alongside your design team to move projects from concept to order."},
  {q:"How do showroom display programs work?", a:"Our manufacturers offer display programs that can subsidize sample and vignette costs for qualifying dealers. Programs vary by brand and typically involve minimum annual purchase commitments. <a href='/contact/'>Contact your Pinnacle Sales rep</a> for current display program details."},
  {q:"Can I carry Pronorm without being a WW Wood Products dealer?", a:"Yes. Pronorm German Kitchens are distributed independently through European Kitchen Distributors (EKD), a Pinnacle Sales company. Pronorm is available nationwide with protected dealer territories, regardless of whether you carry WW Wood brands. Map: <a href='/guides/protected-dealer-territories/'>protected dealer territories</a>."}
];
const stripTags = (s) => s.replace(/<[^>]+>/g, '');
const faqSchema = {"@context":"https://schema.org","@type":"FAQPage","mainEntity":faqs.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":stripTags(f.a)}}))};
---
<BaseLayout title="Kitchen Cabinet Dealer FAQs — Brands, Territories & Support | Pinnacle Sales" description="Frequently asked questions about becoming a Pinnacle Sales dealer, our cabinetry brands, lead times, territory coverage, and dealer support services." schema={faqSchema}>
<div class="page-header"><h1>Frequently Asked Questions</h1><p>Everything you need to know about partnering with Pinnacle Sales.</p></div>
<div class="content-narrow section">
<Breadcrumbs items={[{name:'Home',href:'/'},{name:'FAQs'}]} />
{faqs.map((faq) => (
<div class="faq-item">
<h2>{faq.q}</h2>
<p set:html={faq.a}></p>
</div>
))}

<h2>Dealer guides</h2>
<ul>
  <li><a href="/guides/how-to-become-a-kitchen-cabinet-dealer/">How to become a kitchen cabinet dealer</a></li>
  <li><a href="/guides/protected-dealer-territories/">Protected dealer territories</a></li>
  <li><a href="/guides/pronorm-american-depths/">Pronorm American depths</a></li>
  <li><a href="/guides/one-showroom-six-lines/">One showroom, six lines</a></li>
  <li><a href="/guides/face-frame-vs-frameless/">Face-frame vs frameless on a dealer floor</a></li>
</ul>

<p class="faq-more">Have a question we didn't answer? <a href="/contact/">Contact us</a> — we reply within two business days.</p>
</div>

<DealerCTA />
</BaseLayout>
<style>
.faq-item { border-bottom: 1px solid #e5e7eb; padding: 1.5rem 0; }
.faq-item:last-child { border-bottom: none; }
.faq-item h2 { font-size: 1.15rem; margin: 0 0 0.75rem; color: #1a1a2e; }
.faq-more { margin-top: 2rem; font-size: 1.05rem; }
</style>
