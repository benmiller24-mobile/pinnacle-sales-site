---
import DealerHubLayout from '../../layouts/DealerHubLayout.astro';
---
<DealerHubLayout title="Activation Plan | Pinnacle Sales Dealer Hub" activeSection="Activation Plan">

<div class="activation-header">
  <p class="activation-badge">Dealer Onboarding</p>
  <h1>Your Activation Plan</h1>
  <p class="activation-intro">Your 21-day guide from account setup to Certified Dealer status. Track your progress, complete each module, and book your Certification Call — all in one place.</p>
</div>

<div class="activation-iframe-wrapper">
  <iframe
    id="activation-iframe"
    src="https://pinnacleap-kwmuduy5.manus.space/"
    title="Dealer Activation Portal"
    allow="fullscreen"
    style="width: 100%; height: 100%; border: none; display: block;"
  ></iframe>
</div>

</DealerHubLayout>

<style is:global>
  /* Override hub-main constraints for activation page */
  .hub-main:has(.activation-header) {
    max-width: 100% !important;
    padding: 1.5rem 2rem 0 !important;
    display: flex !important;
    flex-direction: column !important;
    height: calc(100vh - 80px) !important;
    overflow: hidden !important;
  }
</style>

<style>
  .activation-header {
    padding: 0 0 0.75rem;
    border-bottom: 1px solid #DFDFDB;
    margin-bottom: 0;
    flex-shrink: 0;
  }
  .activation-badge {
    font-family: 'Questrial', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #AFA497;
    margin-bottom: 4px;
  }
  .activation-header h1 {
    font-family: 'Questrial', sans-serif;
    font-size: 1.5rem;
    color: #000000;
    margin: 0 0 6px 0;
  }
  .activation-intro {
    font-family: 'Assistant', sans-serif;
    font-size: 0.875rem;
    color: #4A4A4D;
    margin: 0;
    line-height: 1.6;
  }
  .activation-iframe-wrapper {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
</style>
