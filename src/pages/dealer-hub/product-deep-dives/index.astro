---
import DealerHubLayout from '../../../layouts/DealerHubLayout.astro';

const dives = [
  {
    name: 'Shiloh Cabinetry',
    href: '/dealer-hub/product-deep-dives/shiloh',
    tier: 'Premium semi-custom',
    construction: 'Framed face-frame · 9 overlay/inset variants',
    sweetSpot: 'Designers who need the widest door, finish, and inset program in the Pinnacle lineup on a 6-week lead time.',
    img: '/images/brands/shiloh-hero.webp',
  },
  {
    name: 'Eclipse Cabinetry',
    href: '/dealer-hub/product-deep-dives/eclipse',
    tier: 'Modern semi-custom · "by Shiloh"',
    construction: 'Frameless full-access',
    sweetSpot: 'Contemporary kitchens that want acrylic, HPL, TFL, or PV fronts at a US-made price.',
    img: '/images/brands/eclipse-hero.webp',
  },
  {
    name: 'Aspect Cabinetry',
    href: '/dealer-hub/product-deep-dives/aspect',
    tier: 'Value / fast-turn',
    construction: 'Framed face-frame · curated 17-door program',
    sweetSpot: 'Builder and budget-driven projects where the designer needs reliable WW Wood quality and lead time without the full Shiloh price.',
    img: '/images/gallery-1.webp',
  },
];
---
<DealerHubLayout title="Product Deep Dives | Pinnacle Sales Dealer Hub" activeSection="Product Deep Dives">

<h1>Product Deep Dives</h1>
<p class="page-subtitle">A guided tour through Shiloh, Eclipse, and Aspect — designed for a Pinnacle rep to walk a designer through brand by brand, and built to live on as a reference the designer can revisit between projects.</p>

<div class="how-to-use">
  <h2 style="margin-top:0;">How to use these pages</h2>
  <p><strong>For the rep:</strong> Each deep dive is structured like a meeting flow — brand story up top, construction and specs in the middle, door styles and finishes at the bottom, designer talking points beside each section. Share your screen, scroll top-to-bottom, and answer questions in the order they come.</p>
  <p><strong>For the designer:</strong> Bookmark the page after the call. The spec tables, finish ranges, and "when to specify" notes are written so you can come back to them mid-project without re-watching the walkthrough.</p>
  <p style="margin-bottom:0;"><strong>Average walkthrough time:</strong> 20–25 minutes per brand if you cover everything. 10 minutes if you skip the specs anatomy and focus on positioning + finishes.</p>
</div>

<h2>Pick a brand to dive into</h2>
<div class="dive-grid">
  {dives.map(dive => (
    <a href={dive.href} class="dive-card">
      <div class="dive-card-image">
        <img src={dive.img} alt={dive.name} loading="lazy" />
      </div>
      <div class="dive-card-body">
        <span class="dive-tier">{dive.tier}</span>
        <h3>{dive.name}</h3>
        <p class="dive-construction">{dive.construction}</p>
        <p class="dive-sweet-spot"><strong>Sweet spot:</strong> {dive.sweetSpot}</p>
        <span class="dive-link">Open deep dive &rarr;</span>
      </div>
    </a>
  ))}
</div>

<h2>Quick brand comparison</h2>
<p>A one-screen reference for "which brand fits this project?" If you only have five minutes with a designer, screen-share this table.</p>
<div class="compare-wrap">
  <table class="compare-table">
    <thead>
      <tr>
        <th scope="col"></th>
        <th scope="col">Shiloh</th>
        <th scope="col">Eclipse</th>
        <th scope="col">Aspect</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">Tier</th>
        <td>Premium semi-custom</td>
        <td>Modern semi-custom · "by Shiloh"</td>
        <td>Value / fast-turn</td>
      </tr>
      <tr>
        <th scope="row">Construction</th>
        <td>Framed face-frame · 9 overlay/inset types</td>
        <td>Frameless full-access</td>
        <td>Framed face-frame, standard or full overlay</td>
      </tr>
      <tr>
        <th scope="row">Cabinet box</th>
        <td>1/2" plywood</td>
        <td>3/4" particleboard (plywood +10%)</td>
        <td>1/2" particleboard</td>
      </tr>
      <tr>
        <th scope="row">Drawer box</th>
        <td>5/8" hardwood dovetail standard (3/4" + walnut available)</td>
        <td>5/8" or 3/4" hardwood dovetail · simulated metal · Blum LEGRABOX</td>
        <td>5/8" hardwood dovetail (only option)</td>
      </tr>
      <tr>
        <th scope="row">Hardware</th>
        <td>Blum TANDEM guides · Blum CLIP top BLUMOTION hinges</td>
        <td>Blum TANDEM guides · Blum CLIP top BLUMOTION hinges</td>
        <td>Blum TANDEM guides · Blum COMPACT BLUMOTION hinges</td>
      </tr>
      <tr>
        <th scope="row">Wood species</th>
        <td>19 — full range incl. walnut, cherry, hickory, alder, white oak (plain/rift/quarter), poplar</td>
        <td>Same 19 as Shiloh + reconstituted oak &amp; walnut veneers</td>
        <td>3 only — American Poplar, Red Oak, Maple</td>
      </tr>
      <tr>
        <th scope="row">Paints</th>
        <td>25 standard SW colors + entire SW palette via custom match</td>
        <td>Same as Shiloh</td>
        <td>~10 standard paints, no custom match</td>
      </tr>
      <tr>
        <th scope="row">Specialty materials</th>
        <td>Olde World, Aged, Weathered stains, glazes</td>
        <td>Acrylic, HPL, matte noir RAUVISIO, TFL, PV, reconstituted veneers (all Metropolitan slab only)</td>
        <td>Standard paints/stains + 3 glazes only</td>
      </tr>
      <tr>
        <th scope="row">Door styles</th>
        <td>50+</td>
        <td>50+ (same as Shiloh) plus Metropolitan slab</td>
        <td>17 in three pricing groups</td>
      </tr>
      <tr>
        <th scope="row">Lead time</th>
