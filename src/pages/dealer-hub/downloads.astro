<style is:global>
  .dl-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin: 1.5rem 0 0.75rem;
  }
  .dl-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    flex: 1;
  }
  .dl-tab {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: all 0.15s;
  }
  .dl-tab:hover { border-color: var(--color-dark); color: var(--color-dark); }
  .dl-tab.active {
    background: var(--color-dark);
    border-color: var(--color-dark);
    color: #fff;
  }
  .dl-search-wrap { flex-shrink: 0; }
  .dl-search {
    font-family: var(--font-body);
    font-size: 0.85rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    width: 200px;
    transition: border-color 0.15s;
  }
  .dl-search:focus { outline: none; border-color: var(--color-dark); }
  .dl-count {
    font-size: 0.78rem;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }
  .dl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.5rem;
  }
  .dl-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-dark);
    transition: border-color 0.15s, background 0.15s;
  }
  .dl-card:hover {
    border-color: var(--color-dark);
    background: var(--color-bg-alt);
    opacity: 1;
  }
  .dl-card.hidden { display: none; }
  .dl-icon { font-size: 1.1rem; flex-shrink: 0; }
  .dl-info { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .dl-name {
    font-size: 0.84rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dl-meta {
    font-size: 0.7rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  @media (max-width: 600px) {
    .dl-search { width: 100%; }
    .dl-controls { flex-direction: column; align-items: stretch; }
  }

  /* Dealer Photos Gallery */
  .photos-heading {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .photos-subtitle {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .photo-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.5rem;
  }
  .photo-filter {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition: all 0.15s;
  }
  .photo-filter:hover { border-color: var(--color-dark); color: var(--color-dark); }
  .photo-filter.active {
    background: var(--color-dark);
    border-color: var(--color-dark);
    color: #fff;
  }
  .photo-count {
    font-size: 0.78rem;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
  }
  .photo-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    color: var(--color-dark);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .photo-card:hover {
    border-color: var(--color-dark);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    opacity: 1;
  }
  .photo-card.hidden { display: none; }
  .photo-card img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
  }
  .photo-label {
    padding: 0.5rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-muted);
  }
  @media (max-width: 600px) {
    .photo-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
  }
</style>

<script is:inline>
(function() {
  var tabs = document.querySelectorAll('.dl-tab');
  var cards = document.querySelectorAll('.dl-card');
  var searchInput = document.getElementById('dl-search');
  var countEl = document.getElementById('dl-count');
  var activeCat = 'all';

  function update() {
    var query = searchInput.value.toLowerCase().trim();
    var visible = 0;
    cards.forEach(function(card) {
      var cat = card.getAttribute('data-cat');
      var name = card.querySelector('.dl-name').textContent.toLowerCase();
      var brand = (card.getAttribute('data-brand') || '').toLowerCase();
      var matchCat = activeCat === 'all' || cat === activeCat;
      var matchSearch = !query || name.indexOf(query) !== -1 || brand.indexOf(query) !== -1 || cat.indexOf(query) !== -1;
      if (matchCat && matchSearch) {
        card.classList.remove('hidden');
        visible++;
      } else {
        card.classList.add('hidden');
      }
    });
    countEl.textContent = visible + ' form' + (visible !== 1 ? 's' : '');
  }

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      tabs.forEach(function(t) { t.classList.remove('active'); });
      tab.classList.add('active');
      activeCat = tab.getAttribute('data-cat');
      update();
    });
  });

  searchInput.addEventListener('input', update);
  update();
})();


// Dealer Photos filter
(function() {
  var filters = document.querySelectorAll('.photo-filter');
  var photos = document.querySelectorAll('.photo-card');
  var photoCount = document.getElementById('photo-count');
  var activePcat = 'all';

  function updatePhotos() {
    var visible = 0;
    photos.forEach(function(card) {
      var cat = card.getAttribute('data-photocat');
      if (activePcat === 'all' || cat === activePcat) {
        card.classList.remove('hidden');
        visible++;
      } else {
        card.classList.add('hidden');
      }
    });
    photoCount.textContent = visible + ' photo' + (visible !== 1 ? 's' : '');
  }

  filters.forEach(function(btn) {
    btn.addEventListener('click', function() {
      filters.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      activePcat = btn.getAttribute('data-photocat');
      updatePhotos();
    });
  });

  updatePhotos();
})();
</script>
