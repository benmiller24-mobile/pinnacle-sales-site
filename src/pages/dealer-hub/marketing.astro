<script is:inline>
  // Copy-to-clipboard for caption library
  document.querySelectorAll('.copy-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var card = btn.closest('.caption-card');
      if (!card) return;
      var text = card.querySelector('.caption-text');
      if (!text) return;
      var raw = text.textContent.replace(/^"|"$/g, '').trim();
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(raw).then(function() {
          var original = btn.textContent;
          btn.textContent = 'Copied ✓';
          btn.classList.add('copied');
          setTimeout(function() {
            btn.textContent = original;
            btn.classList.remove('copied');
          }, 1500);
        });
      } else {
        // Fallback: select the text so the dealer can Cmd/Ctrl+C
        var range = document.createRange();
        range.selectNodeContents(text);
        var sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
      }
    });
  });
</script>

