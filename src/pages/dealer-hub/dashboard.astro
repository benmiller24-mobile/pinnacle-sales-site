---
import DealerHubLayout from '../../layouts/DealerHubLayout.astro';
---
<DealerHubLayout title="Dealer Hub Dashboard | Pinnacle Sales" activeSection="Dashboard">

<h1>Dealer Hub</h1>
<p class="page-subtitle">Everything you need to succeed as a Pinnacle Sales dealer partner.</p>

<!-- Welcome Banner -->
<div class="welcome-banner" id="welcome-banner">
  <button class="banner-dismiss" id="banner-dismiss" aria-label="Dismiss">&times;</button>
  <div class="banner-content">
    <h2>Welcome to the Pinnacle Sales Dealer Hub</h2>
    <p>Start with your <strong>Activation Plan</strong> — a personalized roadmap that walks you through onboarding, training, and your first order. You can also explore any section from the cards below.</p>
    <a href="/dealer-hub/activation" class="banner-cta">Open Your Activation Plan &rarr;</a>
  </div>
</div>

<div class="card-grid">
  <a href="/dealer-hub/activation" class="hub-card hub-card-featured">
    <span class="card-icon">🚀</span>
    <h3>Activation Plan</h3>
    <p>Your personalized onboarding roadmap — track progress, access resources, and schedule training.</p>
  </a>
  <a href="/dealer-hub/onboarding" class="hub-card">
    <span class="card-icon">✓</span>
    <h3>Dealer Onboarding</h3>
    <p>Step-by-step guide from account activation to first order. Track your progress.</p>
  </a>
  <a href="/dealer-hub/designer-onboarding" class="hub-card">
    <span class="card-icon">✏</span>
    <h3>Designer Onboarding</h3>
    <p>Training roadmap for new designers — product orientation, 2020 training, and first orders.</p>
  </a>
  <a href="/dealer-hub/ordering" class="hub-card">
    <span class="card-icon">📋</span>
    <h3>Ordering SOPs</h3>
    <p>Standard operating procedures for every brand — from quoting to delivery.</p>
  </a>
  <a href="/dealer-hub/training" class="hub-card">
    <span class="card-icon">🎓</span>
    <h3>Training & Resources</h3>
    <p>Product training, sales scripts, competitive positioning, and design tools.</p>
  </a>
  <a href="/dealer-hub/marketing" class="hub-card">
    <span class="card-icon">📣</span>
    <h3>Marketing Kit</h3>
    <p>Brand assets, social media content, showroom signage, and marketing resources.</p>
  </a>
  <a href="/dealer-hub/showroom" class="hub-card">
    <span class="card-icon">🏠</span>
    <h3>Showroom Standards</h3>
    <p>Display requirements, merchandiser specs, sample programs, and visual guidelines.</p>
  </a>
  <a href="/dealer-hub/support" class="hub-card">
    <span class="card-icon">🔧</span>
    <h3>Support & Escalation</h3>
    <p>Know exactly who to contact for design, warranty, rush orders, and more.</p>
  </a>
  <a href="/dealer-hub/submit" class="hub-card">
    <span class="card-icon">📨</span>
    <h3>Submit a Request</h3>
    <p>Send a design for review, an order for pre-check, or request a Zoom training session.</p>
  </a>
</div>

<h2>Quick Contacts</h2>
<div class="card-grid">
  <div class="hub-card">
    <h3>General Support</h3>
    <p>480-993-9224 · <a href="mailto:marketing@pinnaclesales.biz">marketing@pinnaclesales.biz</a></p>
  </div>
  <div class="hub-card">
    <h3>WW Wood Customer Service</h3>
    <p>573-624-7090 · <a href="mailto:customer.service@wwinc.com">customer.service@wwinc.com</a></p>
  </div>
</div>

</DealerHubLayout>

<style>
  .welcome-banner {
    position: relative;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: #fff;
    border-radius: 8px;
    padding: 2rem 2.5rem;
    margin-bottom: 2rem;
  }
  .welcome-banner h2 {
    color: #fff;
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }
  .welcome-banner p {
    color: rgba(255,255,255,0.85);
    margin: 0 0 1.25rem;
    line-height: 1.6;
    max-width: 600px;
  }
  .banner-cta {
    display: inline-block;
    background: #fff;
    color: #1a1a2e;
    padding: 0.55rem 1.25rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 0.15s;
  }
  .banner-cta:hover { background: #e8e8e8; }
  .banner-dismiss {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    background: none;
    border: none;
    color: rgba(255,255,255,0.5);
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem;
  }
  .banner-dismiss:hover { color: #fff; }

  .hub-card-featured {
    border: 2px solid var(--color-dark) !important;
    background: rgba(0,0,0,0.02);
  }
</style>

<script is:inline>
  // Dismiss welcome banner with localStorage persistence
  (function() {
    var banner = document.getElementById('welcome-banner');
    var dismiss = document.getElementById('banner-dismiss');
    if (localStorage.getItem('ps_welcome_dismissed') === 'true' && banner) {
      banner.style.display = 'none';
    }
    if (dismiss) {
      dismiss.addEventListener('click', function() {
        banner.style.display = 'none';
        localStorage.setItem('ps_welcome_dismissed', 'true');
      });
    }
  })();
</script>
