---
import BaseLayout from '../layouts/BaseLayout.astro';
import DealerCTA from '../components/DealerCTA.astro';
import { blogPosts } from '../data/blogPosts';
import { projects } from '../data/projects';
import Testimonials from '../components/Testimonials.astro';

const localBusinessSchema = {"@context":"https://schema.org","@type":"LocalBusiness","name":"Pinnacle Sales","image":"https://www.pinnaclesales.biz/images/pinnacle-sales-og.jpg","telephone":"+1-480-993-9224","address":{"@type":"PostalAddress","addressRegion":"AZ","addressCountry":"US"},"url":"https://www.pinnaclesales.biz","priceRange":"$$-$$$$","openingHours":"Mo-Fr 08:00-17:00"};
const recentPosts = blogPosts.slice(0, 3);
// Lookbook for the homepage: 6 strongest projects. Featured entries first,
// then fill with the most recent projects to reach 6.
const featuredProjects = projects.filter(p => p.featured);
const otherProjects   = projects.filter(p => !p.featured);
const homepageProjects = [...featuredProjects, ...otherProjects].slice(0, 6);
---
<BaseLayout title="Pinnacle Sales — Kitchen Cabinet Manufacturer's Rep, 10 Western States" description="Pinnacle Sales reps Shiloh, Eclipse, Aspect, Pronorm & Vistora cabinetry across 10 Western states. 23+ years of kitchen-dealer support." schema={localBusinessSchema}>

<!-- Hero -->
<section class="hero">
  <div class="hero-bg">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/images/hero-kitchen.webp"
      aria-label="Caruso Kitchen Designs Eclipse Cabinetry installation"
    >
      <source src="/videos/caruso-eclipse-kitchen.mp4" type="video/mp4" />
      <img src="/images/hero-kitchen.webp" alt="Modern kitchen with Shiloh Cabinetry" />
    </video>
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h4 class="hero-tagline">Connect | Collaborate | Create</h4>
    <h1>Premium Kitchen & Bath Cabinetry for Dealers Across 10 Western US States</h1>
    <p>Pinnacle Sales is the leading Manufacturer's Representative to the Kitchen and Bath Industry, serving Arizona, California, Colorado, Idaho, Montana, Nevada, New Mexico, Oregon, Utah, and Washington. We connect kitchen and bath dealers with premium brands including <a href="/brands/shiloh-cabinetry">Shiloh Cabinetry</a>, <a href="/brands/eclipse-cabinetry">Eclipse Cabinetry</a>, <a href="/brands/aspect-cabinetry">Aspect Cabinetry</a>, <a href="/brands/pronorm-german-kitchens">Pronorm German Kitchens</a>, <a href="/brands/vistora-closets">Vistora Closets</a>, and <a href="/brands/us-stone-group">US Stone Group</a> luxury surfaces — backed by 23+ years of industry expertise, hands-on sales training, and showroom support.</p>
    <a href="/become-a-dealer" class="btn btn-white">Become a Dealer</a>
  </div>
</section>

<!-- Value Props -->
<section class="section">
  <div class="container">
    <h2 class="section-heading">Why Dealers Choose Pinnacle Sales</h2>
    <div class="value-grid">
      <div class="value-card">
        <h3>Premium Brands</h3>
        <p>Shiloh, Eclipse, Aspect Cabinetry, Pronorm German Kitchens, and Vistora Closets — made in the USA and Europe with unmatched design flexibility and price-to-value across every market tier.</p>
      </div>
      <div class="value-card">
        <h3>Hands-On Support</h3>
        <p>Sales training, showroom merchandising, technical help, 2020/Winner design services, and marketing resources tailored to your team. We work alongside you to close more projects.</p>
      </div>
      <div class="value-card">
        <h3>10-State Territory</h3>
        <p>Deep market expertise across Arizona, California, Colorado, Idaho, Montana, Nevada, New Mexico, Oregon, Utah, and Washington. We know your local design trends and competition.</p>
      </div>
    </div>
  </div>
</section>

<!-- Project Lookbook -->
<section class="section">
  <div class="container">
    <div class="projects-header">
      <div>
        <h2 class="section-heading">Selected Dealer Work</h2>
        <p class="section-sub">Real kitchens, baths, and whole-home installs from Pinnacle Sales dealer partners across the Western US.</p>
      </div>
      <a href="/projects" class="btn btn-outline btn-sm">View all projects &rarr;</a>
    </div>
    <div class="lookbook-grid">
      {homepageProjects.map((p) => (
        <a href={`/projects/${p.slug}`} class="lookbook-tile" aria-label={p.title}>
          <img src={`/images/projects/${p.slug}/${p.hero}`} alt={p.title} loading="lazy" width="800" height="600" />
          <span class="lookbook-tile-overlay">
            <span class="lookbook-tile-dealer">{p.dealer}</span>
            <span class="lookbook-tile-meta">{p.brand} &middot; {p.location}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- Brands -->
<section class="section section-alt">
  <div class="container">
    <h2 class="section-heading">Premium Cabinetry Brands That Drive Dealer Growth</h2>
    <div class="brand-list">
      <div class="brand-card">
        <div class="brand-logo-wrap">
          <img src="/images/shiloh-logo.webp" alt="Shiloh Cabinetry" class="brand-logo" loading="lazy" />
        </div>
        <div class="brand-info">
          <span class="brand-tag">Face-Frame & Inset</span>
          <h3><a href="/brands/shiloh-cabinetry">Shiloh Cabinetry</a></h3>
          <p>Shiloh Cabinetry is a family-owned, American-made brand renowned for its product value and diverse customization options. With a wide range of styles, finishes, and wood species, Shiloh allows homeowners and designers to create unique, tailored cabinetry solutions. Premium construction features like dovetail drawers, full-extension glides, and soft-close hinges come standard at a competitive price point.</p>
          <a href="/brands/shiloh-cabinetry" class="brand-link">Learn more &rarr;</a>
        </div>
      </div>

      <div class="brand-card">
        <div class="brand-logo-wrap">
          <img src="/images/eclipse-logo.webp" alt="Eclipse Cabinetry" class="brand-logo" loading="lazy" />
        </div>
        <div class="brand-info">
          <span class="brand-tag">Frameless Full-Access</span>
          <h3><a href="/brands/eclipse-cabinetry">Eclipse Cabinetry</a></h3>
          <p>Eclipse Cabinetry is a modern, frameless cabinetry line that combines sleek, contemporary design with superior functionality. Built with precision and durability, Eclipse offers clean lines, full-access storage, and a wide selection of finishes. Its frameless construction maximizes usable space, while premium features ensure a seamless, high-end user experience.</p>
          <a href="/brands/eclipse-cabinetry" class="brand-link">Learn more &rarr;</a>
        </div>
      </div>

      <div class="brand-card">
        <div class="brand-logo-wrap">
          <img src="/images/aspect-logo.webp" alt="Aspect Cabinetry" class="brand-logo" loading="lazy" />
        </div>
        <div class="brand-info">
          <span class="brand-tag">Value Semi-Custom</span>
          <h3><a href="/brands/aspect-cabinetry">Aspect Cabinetry</a></h3>
          <p>Aspect Cabinetry offers a perfect blend of quality, style, and affordability, making it an ideal choice for homeowners seeking value-driven semi-custom cabinetry. Durable construction and attention to detail ensure long-lasting performance, while competitive pricing makes quality cabinetry accessible for a variety of budgets.</p>
          <a href="/brands/aspect-cabinetry" class="brand-link">Learn more &rarr;</a>
        </div>
      </div>

      <div class="brand-card">
        <div class="brand-logo-wrap">
          <img src="/images/pronorm-logo.webp" alt="Pronorm German Kitchens" class="brand-logo" loading="lazy" />
        </div>
        <div class="brand-info">
          <span class="brand-tag">Premium European</span>
          <h3><a href="/brands/pronorm-german-kitchens">Pronorm German Kitchens</a></h3>
          <p>Pronorm Einbauküchen is a premium fitted German kitchen brand known for its sleek, contemporary designs and exceptional functionality. With a focus on modularity and customization, Pronorm offers a wide range of finishes, materials, and innovative storage solutions. Built with precision engineering and high-quality German craftsmanship.</p>
          <a href="/brands/pronorm-german-kitchens" class="brand-link">Learn more &rarr;</a>
        </div>
      </div>

      <div class="brand-card">
        <div class="brand-logo-wrap">
          <img src="/images/vistora-logo.webp" alt="Vistora Closets" class="brand-logo" loading="lazy" />
        </div>
        <div class="brand-info">
          <span class="brand-tag">Made-to-Order Closets & Storage</span>
          <h3><a href="/brands/vistora-closets">Vistora Closets</a></h3>
          <p>Vistora Closets, by WW Wood Products, specializes in made-to-order closet solutions designed to maximize storage and enhance organization with style. Offering a variety of finishes, configurations, and accessories, Vistora combines functionality with modern aesthetics to create personalized spaces.</p>
          <a href="/brands/vistora-closets" class="brand-link">Learn more &rarr;</a>
        </div>
      </div>

      <div class="brand-card">
        <div class="brand-logo-wrap">
          <img src="/images/brands/us-stone-group/logo.webp" alt="US Stone Group" class="brand-logo" loading="lazy" />
        </div>
        <div class="brand-info">
          <span class="brand-tag">Luxury Stone Surfaces</span>
          <h3><a href="/brands/us-stone-group">US Stone Group</a></h3>
          <p>US Stone Group is a luxury stone and surface supplier offering hand-selected natural stone, semi-precious gemstone, and large-format Italian porcelain slabs from the world's finest quarries — including the signature Cristallo and Patagonia quartzite lines. Now distributed by Pinnacle Sales, it brings the countertop to the same showroom as the cabinetry.</p>
          <a href="/brands/us-stone-group" class="brand-link">Learn more &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</section>

<Testimonials />

<!-- Playbook Promo -->
<section class="section">
  <div class="container">
    <div class="playbook-promo">
      <h2>The Kitchen Dealer Playbook</h2>
      <p>Your go-to resource for growing a profitable kitchen design business. Product deep dives, dealer success stories, design trend analysis, and operational insights.</p>
      <div class="playbook-posts">
        {recentPosts.map(post => (
          <a href={`/playbook/${post.slug}`} class="playbook-card">
            <span class="playbook-cat">{post.category}</span>
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
          </a>
        ))}
      </div>
      <div style="text-align:center;margin-top:2rem;">
        <a href="/playbook" class="btn btn-outline">Read the Playbook</a>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<DealerCTA />

<!-- LinkedIn -->
<section class="section" style="text-align:center;">
  <div class="container">
    <h2 class="section-heading">Follow Us on LinkedIn</h2>
    <p style="color:var(--color-muted);max-width:500px;margin:0 auto 2rem;">Stay connected with product launches, dealer spotlights, and industry insights.</p>
    <a href="https://www.linkedin.com/company/pinnacle-sales-kbi" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Pinnacle Sales LinkedIn</a>
  </div>
</section>

<!-- NKBA Badge -->
<section style="text-align:center;padding:2rem 0 4rem;">
  <img src="/images/nkba-certified.webp" alt="NKBA Certified Member" style="max-width:200px;margin:0 auto;opacity:0.6;" loading="lazy" />
</section>

</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 850px;
    padding: 4rem 2rem;
    color: #fff;
  }
  .hero-tagline {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }
  .hero h1 {
    color: #fff;
    font-size: 2.75rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    margin-bottom: 1.5rem;
    line-height: 1.25;
  }
  .hero-content p {
    font-size: 1rem;
    color: rgba(255,255,255,0.8);
    line-height: 1.9;
    margin-bottom: 2.5rem;
  }
  .hero-content p a { color: var(--color-accent); }

  /* Section Heading */
  .section-heading {
    text-align: center;
    margin-bottom: 3rem;
    font-size: 1.5rem;
  }

  /* Value Props */
  .value-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
  .value-card {
    text-align: center;
    padding: 2rem 1.5rem;
  }
  .value-card h3 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }
  .value-card p {
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  /* Gallery Strip */
  .gallery-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }
  .gallery-strip img {
    width: 100%;
    height: 350px;
    object-fit: cover;
    object-position: center;
  }

  /* Brands */
  .section-alt { background: var(--color-bg-warm); }
  .brand-list { display: flex; flex-direction: column; gap: 2rem; }
  .brand-card {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2.5rem;
    align-items: start;
    background: #fff;
    padding: 2.5rem;
    border: 1px solid var(--color-border);
  }
  .brand-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80px;
  }
  .brand-logo { max-width: 160px; max-height: 70px; object-fit: contain; }
  .brand-tag {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.2rem 0.6rem;
    margin-bottom: 0.5rem;
  }
  .brand-info h3 { margin-top: 0; font-size: 1.15rem; }
  .brand-info h3 a { color: #000; text-decoration: none; }
  .brand-info h3 a:hover { opacity: 0.6; }
  .brand-info p { color: var(--color-muted); font-size: 0.95rem; }
  .brand-link {
    color: #000;
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .brand-link:hover { opacity: 0.5; }

  /* Playbook */
  .playbook-promo { text-align: center; }
  .playbook-promo h2 { margin-bottom: 0.75rem; }
  .playbook-promo > p { color: var(--color-muted); max-width: 600px; margin: 0 auto 2.5rem; }
  .playbook-posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: left;
  }
  .playbook-card {
    border: 1px solid var(--color-border);
    padding: 2rem;
    text-decoration: none;
    color: var(--color-body);
    transition: border-color 0.3s, box-shadow 0.3s;
    display: block;
  }
  .playbook-card:hover { border-color: #999; box-shadow: 0 4px 20px rgba(0,0,0,0.06); opacity: 1; }
  .playbook-cat {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .playbook-card h3 {
    font-size: 1rem;
    margin: 0.5rem 0 0.75rem;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: 0;
  }
  .playbook-card p {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.7;
  }

  @media (max-width: 768px) {
    .hero { min-height: 70vh; }
    .hero h1 { font-size: 1.75rem; }
    .value-grid { grid-template-columns: 1fr; gap: 1rem; }
    .gallery-strip { grid-template-columns: 1fr; }
    .gallery-strip img { height: 250px; }
    .brand-card { grid-template-columns: 1fr; text-align: center; }
    .brand-logo-wrap { justify-content: center; }
    .brand-info { text-align: left; }
    .playbook-posts { grid-template-columns: 1fr; }
  }

  /* Featured Projects */
  .projects-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .projects-header .section-heading {
    text-align: left;
    margin-bottom: 0.4rem;
  }
  .section-sub {
    color: var(--color-muted, #666);
    margin: 0;
    max-width: 560px;
    font-size: 1rem;
  }
  .btn-sm {
    padding: 0.55rem 1.2rem;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  .featured-projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .featured-project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border, #e0e0e0);
    background: #fff;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .featured-project-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(0,0,0,0.08);
    opacity: 1;
  }
  .featured-project-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-alt, #f7f7f7);
  }
  .featured-project-image img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .featured-project-card:hover .featured-project-image img { transform: scale(1.04); }
  .featured-project-brand {
    position: absolute;
    bottom: 0.6rem; left: 0.6rem;
    background: rgba(0,0,0,0.75); color: #fff;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
  }
  .featured-project-body { padding: 1rem 1.1rem 1.25rem; }
  .featured-project-body h3 {
    font-size: 1rem;
    line-height: 1.3;
    font-weight: 500;
    margin: 0 0 0.3rem;
  }
  .featured-project-meta {
    font-size: 0.78rem;
    color: var(--color-light-text, #999);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0;
  }
  @media (max-width: 700px) {
    .projects-header { flex-direction: column; align-items: stretch; }
    .projects-header .btn-sm { align-self: flex-start; }
  }

  /* Hero video */
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Lookbook grid (6-up) */
  .lookbook-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .lookbook-tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-alt, #f7f7f7);
    text-decoration: none;
    color: inherit;
  }
  .lookbook-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .lookbook-tile:hover img { transform: scale(1.05); opacity: 1; }
  .lookbook-tile:hover { opacity: 1; }
  .lookbook-tile-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.6rem 1rem 1rem;
    background: linear-gradient(to top, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.0) 100%);
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    pointer-events: none;
    opacity: 0.95;
  }
  .lookbook-tile-dealer {
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.25;
  }
  .lookbook-tile-meta {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  @media (max-width: 900px) {
    .lookbook-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .lookbook-grid { grid-template-columns: 1fr; }
  }
</style>
