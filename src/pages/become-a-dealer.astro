---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Testimonials from '../components/Testimonials.astro';
const contactSchema = {"@context":"https://schema.org","@type":"ContactPage","name":"Become a Pinnacle Sales Dealer","description":"Apply to become a Pinnacle Sales kitchen and bath cabinetry dealer. Carry Shiloh, Eclipse, Aspect, Pronorm, Vistora, and US Stone Group across 10 Western US states.","mainEntity":{"@type":"Organization","name":"Pinnacle Sales","url":"https://pinnaclesales.biz","contactPoint":{"@type":"ContactPoint","telephone":"+1-480-993-9224","contactType":"sales","email":"info@pinnaclesales.biz","areaServed":["Arizona","California","Colorado","Idaho","Montana","Nevada","New Mexico","Oregon","Utah","Washington"],"availableLanguage":["English"]}},"potentialAction":{"@type":"ApplyAction","name":"Apply to become a dealer","target":"https://pinnaclesales.biz/dealer-hub/submit/"}};

const dealerFaqs = [
  {q:"How do I become a Pinnacle Sales dealer?", a:"Submit the dealer application on this page. We'll follow up within two business days to schedule an introductory call, review your market and showroom, and discuss which of our brands — Shiloh, Eclipse, Aspect, Pronorm, Vistora, or US Stone Group — best fit your business."},
  {q:"Is there a cost or minimum order to become a dealer?", a:"There is no fee to apply or to become an authorized dealer. Minimum order requirements and display commitments vary by brand and program; we'll walk through the specifics for the lines you're interested in during your introductory call."},
  {q:"Do you offer protected dealer territories?", a:"Yes. Territory protection varies by brand and market. Pronorm German Kitchens are available nationwide with protected dealer territories, and we manage territory carefully for our WW Wood Products lines (Shiloh, Eclipse, Aspect, Vistora) across the 10 Western states we represent."},
  {q:"Which states does Pinnacle Sales cover?", a:"We represent dealers across Arizona, California, Colorado, Idaho, Montana, Nevada, New Mexico, Oregon, Utah, and Washington for WW Wood Products brands. Pronorm German Kitchens are available to qualified dealers nationwide."},
  {q:"Can I carry Pronorm without carrying the WW Wood Products brands?", a:"Yes. Pronorm German Kitchens are distributed independently through European Kitchen Distributors (EKD), a Pinnacle Sales company, with protected territories nationwide — regardless of whether you carry Shiloh, Eclipse, Aspect, or Vistora."},
  {q:"What support do you provide after I become a dealer?", a:"Hands-on in-person sales training, 2020/Winner design and quoting support, showroom merchandising and display programs, co-branded marketing resources, factory access and tours, and ongoing business development — we work alongside your team to close more projects."},
  {q:"What types of businesses do you work with?", a:"Independent kitchen & bath showrooms, design-build firms, custom home builders, interior design studios with product sales capability, and multi-location dealer groups — from single showrooms to growing enterprises."}
];
const dealerFaqSchema = {"@context":"https://schema.org","@type":"FAQPage","mainEntity":dealerFaqs.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))};
---
<BaseLayout title="Become a Kitchen Cabinet Dealer — Shiloh, Eclipse, Pronorm | Pinnacle Sales" description="Apply to become a Pinnacle Sales dealer. Shiloh, Eclipse, Aspect, Pronorm & Vistora cabinetry plus US Stone Group luxury surfaces — with training, showroom support, and territory protection." schema={[contactSchema, dealerFaqSchema]}>
<div class="page-header"><h1>Become a Pinnacle Sales Dealer</h1><p>Partner with the leading cabinetry rep firm in the Western US. Premium cabinetry and luxury surfaces, one trusted partnership.</p><a href="#apply" class="btn btn-white header-apply">Apply Now</a></div>
<div class="content-narrow section">
<Breadcrumbs items={[{name:'Home',href:'/'},{name:'Become a Dealer'}]} />

<p>Whether you are an established kitchen dealer looking to expand your brand portfolio or an entrepreneur exploring how to launch a new showroom, Pinnacle Sales offers the brands, training, and hands-on support you need to build a profitable cabinetry business.</p>

<h2>Why Partner with Pinnacle Sales?</h2>

<div class="benefits-grid">
<div class="benefit">
<h3>Premium Brands</h3>
<p><a href="/brands/shiloh-cabinetry">Shiloh</a>, <a href="/brands/eclipse-cabinetry">Eclipse</a>, <a href="/brands/aspect-cabinetry">Aspect</a>, <a href="/brands/pronorm-german-kitchens">Pronorm</a>, <a href="/brands/vistora-closets">Vistora</a>, and <a href="/brands/us-stone-group">US Stone Group</a> cover every market tier from value semi-custom to ultra-premium European design — plus luxury surfaces. One partnership gives you a complete product lineup for any client and budget.</p>
</div>
<div class="benefit">
<h3>Hands-On Sales Training</h3>
<p>We train your sales team in person — product knowledge, competitive positioning, objection handling, and closing strategies tailored to your market. Not webinars. Real training in your showroom with your team.</p>
</div>
<div class="benefit">
<h3>Showroom Merchandising</h3>
<p>We help you plan, design, and set up showroom displays that drive conversations and close sales. From door sample walls to full kitchen vignettes, we provide merchandising guidance and display programs.</p>
</div>
<div class="benefit">
<h3>Design & Quoting Support</h3>
<p>Our team offers 2020/Winner design and quoting services to help you move projects from concept to order efficiently. We support complex projects, multi-brand quotes, and custom specifications.</p>
</div>
<div class="benefit">
<h3>Marketing Resources</h3>
<p>Co-branded content, photography, project showcases, and digital marketing support to help you attract homeowners and builders to your showroom.</p>
</div>
<div class="benefit">
<h3>Factory Access</h3>
<p>Direct relationships with WW Wood Products and Pronorm factory teams. We coordinate factory tours, technical consultations, and custom project support at the manufacturing level.</p>
</div>
</div>

<Testimonials
  heading="What Pinnacle Sales Dealers Say"
  subhead="Why showroom owners across the Western US trust us as their cabinetry rep firm."
  limit={3}
/>

<div class="social-proof">
<h2>Trusted by Dealers Across the West</h2>
<div class="stats-bar">
<div class="stat"><span class="stat-number">23+</span><span class="stat-label">Years in Business</span></div>
<div class="stat"><span class="stat-number">100+</span><span class="stat-label">Active Dealers</span></div>
<div class="stat"><span class="stat-number">10</span><span class="stat-label">Western States</span></div>
<div class="stat"><span class="stat-number">6</span><span class="stat-label">Premium Brands</span></div>
</div>
</div>

<h2>Available Territories</h2>

<p>We serve dealers in Arizona, California, Colorado, Idaho, Montana, Nevada, New Mexico, Oregon, Utah, and Washington. Pronorm German Kitchens are available nationwide with protected dealer territories.</p>

<p>Territory availability varies by brand and market. Contact us to discuss what is open in your area.</p>

<h2>Who We Work With</h2>

<p>Our dealer partners include independent kitchen and bath showrooms, design-build firms, custom home builders, interior design studios with product sales capability, and multi-location dealer groups. Whether you are a single-location showroom or a growing enterprise, we structure our support to match your business needs.</p>

<h2>Dealer Program FAQs</h2>
<div class="dealer-faqs">
{dealerFaqs.map((faq) => (
<div class="faq-item">
<h3>{faq.q}</h3>
<p>{faq.a}</p>
</div>
))}
</div>

<h2 id="apply">Apply to Become a Dealer</h2>

<p>Complete the form below and our team will follow up within two business days to schedule an introductory call. We will discuss your market, showroom, current product lines, and which Pinnacle Sales brands are the best fit for your business.</p>

<form name="dealer-application" method="POST" action="/thank-you-dealer/" data-netlify="true" netlify-honeypot="bot-field" class="dealer-form">
<input type="hidden" name="form-name" value="dealer-application" />
<input type="hidden" name="source-page" id="source-page" />
<p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

<div class="form-group">
<label for="contact-name">Your Name <span class="required">*</span></label>
<input type="text" id="contact-name" name="name" required />
</div>

<div class="form-group">
<label for="company">Company / Showroom Name <span class="required">*</span></label>
<input type="text" id="company" name="company" required />
</div>

<div class="form-row">
<div class="form-group">
<label for="email">Email <span class="required">*</span></label>
<input type="email" id="email" name="email" required />
</div>
<div class="form-group">
<label for="phone">Phone <span class="required">*</span></label>
<input type="tel" id="phone" name="phone" required />
</div>
</div>

<div class="form-row">
<div class="form-group">
<label for="city">City <span class="required">*</span></label>
<input type="text" id="city" name="city" required />
</div>
<div class="form-group">
<label for="state">State <span class="required">*</span></label>
<select id="state" name="state" required>
<option value="">Select state...</option>
<option value="AZ">Arizona</option>
<option value="CA">California</option>
<option value="CO">Colorado</option>
<option value="ID">Idaho</option>
<option value="MT">Montana</option>
<option value="NV">Nevada</option>
<option value="NM">New Mexico</option>
<option value="OR">Oregon</option>
<option value="UT">Utah</option>
<option value="WA">Washington</option>
<option value="Other">Other (Pronorm nationwide)</option>
</select>
</div>
</div>

<div class="form-group">
<label for="website">Website URL</label>
<input type="url" id="website" name="website" placeholder="https://" />
</div>

<div class="form-group">
<label for="business-type">Business Type <span class="required">*</span></label>
<select id="business-type" name="business-type" required>
<option value="">Select type...</option>
<option value="Kitchen & Bath Showroom">Kitchen & Bath Showroom</option>
<option value="Design-Build Firm">Design-Build Firm</option>
<option value="Interior Design Studio">Interior Design Studio</option>
<option value="Custom Home Builder">Custom Home Builder</option>
<option value="Multi-Location Dealer">Multi-Location Dealer Group</option>
<option value="New Business / Startup">New Business / Startup</option>
<option value="Other">Other</option>
</select>
</div>

<div class="form-group">
<label for="brands-interest">Which brands are you most interested in?</label>
<div class="checkbox-group">
<label class="checkbox-label"><input type="checkbox" name="brands-interest" value="Shiloh Cabinetry" /> Shiloh Cabinetry</label>
<label class="checkbox-label"><input type="checkbox" name="brands-interest" value="Eclipse Cabinetry" /> Eclipse Cabinetry</label>
<label class="checkbox-label"><input type="checkbox" name="brands-interest" value="Aspect Cabinetry" /> Aspect Cabinetry</label>
<label class="checkbox-label"><input type="checkbox" name="brands-interest" value="Pronorm German Kitchens" /> Pronorm German Kitchens</label>
<label class="checkbox-label"><input type="checkbox" name="brands-interest" value="Vistora Closets" /> Vistora Closets</label>
<label class="checkbox-label"><input type="checkbox" name="brands-interest" value="US Stone Group" /> US Stone Group</label>
</div>
</div>

<div class="form-group">
<label for="current-lines">What cabinet lines do you currently carry?</label>
<textarea id="current-lines" name="current-lines" rows="3" placeholder="List your current brands and approximate annual volume if comfortable sharing..."></textarea>
</div>

<div class="form-group">
<label for="message">Anything else you'd like us to know?</label>
<textarea id="message" name="message" rows="3"></textarea>
</div>

<button type="submit" class="btn-primary">Submit Application</button>
</form>

<p style="margin-top:2rem;color:#6b7280;font-size:.9rem;">Prefer to talk first? Call <a href="tel:+14809939224">480-993-9224</a> or email <a href="mailto:marketing@pinnaclesales.biz">marketing@pinnaclesales.biz</a>.</p>

</div>

<script is:inline>
(function () {
  // Attribution: which page sent this visitor to the application
  try {
    var src = '';
    if (document.referrer) {
      var r = new URL(document.referrer);
      if (r.host === location.host) src = r.pathname;
    }
    document.getElementById('source-page').value = src || 'direct';
  } catch (e) {}

  // Stash lead context; the GA4 generate_lead conversion fires on /thank-you-dealer/
  // (firing on the destination page survives the form's full-page navigation).
  document.querySelector('form[name="dealer-application"]')?.addEventListener('submit', function () {
    if (this.elements['bot-field'] && this.elements['bot-field'].value) return; // honeypot: no conversion for spam
    try {
      sessionStorage.setItem('ps_lead', JSON.stringify({
        form: 'dealer-application',
        lead_type: 'Dealer Application',
        source: document.getElementById('source-page').value
      }));
    } catch (e) {}
  });
})();
</script>

</BaseLayout>
<style>
.benefits-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.25rem;margin:1.5rem 0}
.benefit{border:1px solid #e5e7eb;border-radius:8px;padding:1.25rem}
.benefit h3{margin:0 0 .5rem;font-size:1.05rem;color:#1a1a2e}
.benefit p{color:#4b5563;margin:0;font-size:.95rem}
.social-proof{margin:2.5rem 0;text-align:center}
.social-proof h2{margin-bottom:1.5rem}
.stats-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:2rem}
.stat{background:#f8fafc;border-radius:10px;padding:1.25rem .75rem}
.stat-number{display:block;font-size:2rem;font-weight:700;color:#1a1a2e}
.stat-label{display:block;font-size:.85rem;color:#6b7280;margin-top:.25rem}
.testimonial{background:#f0f7ff;border-left:4px solid #2563eb;border-radius:8px;padding:1.5rem 2rem;margin:0 auto;max-width:640px;text-align:left;font-style:italic}
.testimonial p{margin:0 0 .75rem;font-size:1.05rem;color:#1e293b;line-height:1.6}
.testimonial cite{font-size:.9rem;color:#64748b;font-style:normal;font-weight:600}
@media(max-width:600px){.stats-bar{grid-template-columns:repeat(2,1fr)}}
.dealer-form{margin-top:1.5rem;max-width:640px}
.form-group{margin-bottom:1.25rem}
.form-group label{display:block;font-weight:600;margin-bottom:.4rem;font-size:.95rem;color:#1a1a2e}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:.65rem .75rem;border:1px solid #d1d5db;border-radius:6px;font-size:.95rem;font-family:inherit;background:#fff;transition:border-color .2s}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{outline:none;border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.1)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
@media(max-width:600px){.form-row{grid-template-columns:1fr}}
.checkbox-group{display:flex;flex-direction:column;gap:.5rem;margin-top:.25rem}
.checkbox-label{display:flex;align-items:center;gap:.5rem;font-weight:400;font-size:.95rem;cursor:pointer}
.checkbox-label input{width:auto;margin:0}
.required{color:#dc2626}
.hidden{display:none}
.btn-primary{background:#1a1a2e;color:#fff;border:none;padding:.75rem 2rem;border-radius:6px;font-size:1rem;font-weight:600;cursor:pointer;transition:background .2s}
.btn-primary:hover{background:#2563eb}
.header-apply{margin-top:1.5rem}
.dealer-faqs{margin:1.25rem 0 2rem}
.faq-item{border-bottom:1px solid #e5e7eb;padding:1.25rem 0}
.faq-item:last-child{border-bottom:none}
.faq-item h3{font-size:1.05rem;margin:0 0 .5rem;color:#1a1a2e}
.faq-item p{margin:0;color:#4b5563;font-size:.95rem;line-height:1.6}
</style>
