---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Testimonials from '../components/Testimonials.astro';
import AttributionFields from '../components/AttributionFields.astro';
import { WW_STATE_NAMES, WW_STATE_NAME_ARRAY, WW_STATE_COUNT, WW_STATE_COUNT_WORD, WW_BRAND_SHORT_NAMES, BRANDS, BRAND_COUNT, BRAND_SHORT_NAMES, FORM_STATE_OPTIONS } from '../data/footprint';
const contactSchema = {"@context":"https://schema.org","@type":"ContactPage","name":"Become a Pinnacle Sales Dealer","description":`Apply to become a Pinnacle Sales kitchen and bath cabinetry dealer: ${BRAND_SHORT_NAMES}. WW Wood lines in ${WW_STATE_NAMES}; Pronorm nationwide.`,"mainEntity":{"@type":"Organization","name":"Pinnacle Sales","url":"https://pinnaclesales.biz","contactPoint":{"@type":"ContactPoint","telephone":"+1-480-993-9224","contactType":"sales","email":"marketing@pinnaclesales.biz","areaServed":WW_STATE_NAME_ARRAY,"availableLanguage":["English"]}},"potentialAction":{"@type":"ApplyAction","name":"Apply to become a dealer","target":"https://pinnaclesales.biz/become-a-dealer/#apply"}};

// Response promise. Keep in step with SAME_DAY_CUTOFF_HOUR in netlify/functions/submission-created/copy.mjs,
// which is what the automated reply to the prospect actually says.
const responsePromise = "A Pinnacle Sales rep will call you the same business day — applications received after 3 pm Pacific get a call first thing the next business morning.";

const states = FORM_STATE_OPTIONS;
const brands = BRANDS.map((b) => b.formValue);

const dealerFaqs = [
  {q:"How do I become a Pinnacle Sales dealer?", a:"Submit the dealer application on this page. Check Shiloh only if that is the line. A Pinnacle Sales rep will call you the same business day (next business morning for applications after 3 pm Pacific). Not ready to apply? <a href='#territory-check'>See what's open in your area</a> first. Shiloh path: <a href='/guides/become-a-shiloh-dealer/'>become a Shiloh dealer</a>. Full process: <a href='/guides/how-to-become-a-kitchen-cabinet-dealer/'>how to become a kitchen cabinet dealer</a>."},
  {q:"Can I apply for Shiloh only?", a:"Yes. Check Shiloh and leave the other boxes blank. Tell us if you build custom and what you used to sell. Details: <a href='/guides/become-a-shiloh-dealer/'>become a Shiloh dealer</a>."},
  {q:"What brands can I carry?", a:`${BRAND_SHORT_NAMES}. See <a href='/guides/one-showroom-six-lines/'>one showroom, every tier</a>.`},
  {q:"What is American depths on Pronorm?", a:"Planned for American rooms and appliances. Factory stays in millimeters. Dealer spec: <a href='/guides/pronorm-american-depths/'>Pronorm American depths</a>."},
  {q:"Is there a cost or minimum order to become a dealer?", a:"There is no fee to apply or to become an authorized dealer. Minimum order requirements and display commitments vary by brand and program; we'll walk through the specifics for the lines you're interested in during your introductory call."},
  {q:"Do you offer protected dealer territories?", a:`Yes. Territory protection varies by brand and market. Pronorm German Kitchens are available nationwide with protected dealer territories, and we manage territory carefully for our WW Wood Products lines (Shiloh, Eclipse, Aspect, Vistora) across the ${WW_STATE_COUNT_WORD} Western states we represent. Details: <a href='/guides/protected-dealer-territories/'>protected dealer territories</a>.`},
  {q:"Which states does Pinnacle Sales cover?", a:`We represent WW Wood Products brands to dealers in ${WW_STATE_NAMES}. Pronorm German Kitchens are available to qualified dealers nationwide.`},
  {q:"Can I carry Pronorm without carrying the WW Wood Products brands?", a:"Yes. Pronorm German Kitchens are distributed independently through European Kitchen Distributors (EKD), the exclusive U.S. distributor, with protected territories nationwide — regardless of whether you carry Shiloh, Eclipse, Aspect, or Vistora."},
  {q:"What support do you provide after I become a dealer?", a:"Hands-on in-person sales training, 2020/Winner design and quoting support, showroom merchandising and display programs, co-branded marketing resources, factory access and tours, and ongoing business development — we work alongside your team to close more projects."},
  {q:"What types of businesses do you work with?", a:"Custom shops adding a factory line, dealers leaving a box or semi-custom program, independent kitchen & bath showrooms, design-build firms, custom home builders, interior studios that sell product, and multi-location dealer groups."}
];
const stripTags = (s) => s.replace(/<[^>]+>/g, '');
const dealerFaqSchema = {"@context":"https://schema.org","@type":"FAQPage","mainEntity":dealerFaqs.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":stripTags(f.a)}}))};
---
<BaseLayout title="Become a Kitchen Cabinet Dealer — Shiloh, Eclipse, Pronorm | Pinnacle Sales" description={`Apply to become a Pinnacle Sales dealer: ${BRAND_SHORT_NAMES}, plus training, showroom support, and territory protection.`} schema={[contactSchema, dealerFaqSchema]}>
<div class="page-header"><h1>Become a Pinnacle Sales Dealer</h1><p>Factory-backed cabinetry lines, in-person training and showroom support from a rep firm that has served Western dealers for 23+ years.</p><div class="header-ctas"><a href="#apply" class="btn btn-white header-apply">Apply Now</a><a href="#territory-check" class="btn btn-ghost header-apply">See what's open near you</a></div></div>
<div class="content-narrow section">
<Breadcrumbs items={[{name:'Home',href:'/'},{name:'Become a Dealer'}]} />

<p>Our best-fit dealers already build custom, or used to sell a box / semi-custom line, and want factory-backed <a href="/guides/become-a-shiloh-dealer/">Shiloh</a>. Check Shiloh on the form. Process: <a href="/guides/how-to-become-a-kitchen-cabinet-dealer/">how to become a kitchen cabinet dealer</a>. Not ready to apply? <a href="#territory-check">See what's open in your area</a> — no application needed.</p>

<h2>Why Partner with Pinnacle Sales?</h2>

<div class="benefits-grid">
<div class="benefit">
<h3>Every Tier, One Partner</h3>
<p><a href="/brands/shiloh-cabinetry/">Shiloh</a>, <a href="/brands/eclipse-cabinetry/">Eclipse</a>, <a href="/brands/aspect-cabinetry/">Aspect</a>, <a href="/brands/vistora-closets/">Vistora</a>, <a href="/brands/pronorm-german-kitchens/">Pronorm</a>, <a href="/brands/us-stone-group/">US Stone</a> — face-frame, frameless, value, closets, German fitted and stone.</p>
</div>
<div class="benefit">
<h3>Hands-On Sales Training</h3>
<p>We train your sales team in person — product knowledge, competitive positioning, objection handling, and closing strategies tailored to your market. Not webinars. Real training in your showroom with your team.</p>
</div>
<div class="benefit">
<h3>Showroom Merchandising</h3>
<p>We help you plan, design, and set up showroom displays that drive conversations and close sales. From door sample walls to full kitchen vignettes, we provide merchandising guidance and display programs.</p>
</div>
<div class="benefit">
<h3>Design & Quoting Support</h3>
<p>Our team offers 2020/Winner design and quoting services to help you move projects from concept to order efficiently. We support complex projects, multi-brand quotes, and custom specifications.</p>
</div>
<div class="benefit">
<h3>Marketing Resources</h3>
<p>Co-branded content, photography, project showcases, and digital marketing support to help you attract homeowners and builders to your showroom.</p>
</div>
<div class="benefit">
<h3>Factory Access</h3>
<p>Direct relationships with WW Wood Products and Pronorm factory teams. We coordinate factory tours, technical consultations, and custom project support at the manufacturing level.</p>
</div>
</div>

<Testimonials
  heading="What Pinnacle Sales Dealers Say"
  subhead="Why showroom owners across the Western US trust us as their cabinetry rep firm."
  limit={3}
/>

<div class="social-proof">
<h2>Trusted by Dealers Across the West</h2>
<div class="stats-bar">
<div class="stat"><span class="stat-number">23+</span><span class="stat-label">Years in Business</span></div>
<div class="stat"><span class="stat-number">100+</span><span class="stat-label">Active Dealers</span></div>
<div class="stat"><span class="stat-number">{WW_STATE_COUNT}</span><span class="stat-label">Western States</span></div>
<div class="stat"><span class="stat-number">{BRAND_COUNT}</span><span class="stat-label">Premium Brands</span></div>
</div>
</div>

<h2>Available Territories</h2>

<p>Our WW Wood lines ({WW_BRAND_SHORT_NAMES}) are available to dealers in {WW_STATE_NAMES}. Pronorm German Kitchens are available nationwide with protected dealer territories.</p>

<p>Territory availability varies by brand and market, and we don't publish a dealer locator — so just ask.</p>

<div class="territory-check" id="territory-check">
<div class="territory-check-intro">
<h3>Curious what's open in your area?</h3>
<p>You don't need to apply to find out. Share your market and the brand you're considering, and a Pinnacle Sales rep will get back to you the same business day with what's available and how territory protection works there. If your market is already covered, we'll let you know and keep you in mind if it opens up.</p>
</div>

<form name="territory-check" method="POST" action="/thank-you-territory/" data-netlify="true" netlify-honeypot="bot-field" class="dealer-form territory-form">
<input type="hidden" name="form-name" value="territory-check" />
<input type="hidden" name="source-page" />
<AttributionFields />
<p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

<div class="form-row">
<div class="form-group">
<label for="tc-name">Your Name <span class="required">*</span></label>
<input type="text" id="tc-name" name="name" required autocomplete="name" />
</div>
<div class="form-group">
<label for="tc-email">Email <span class="required">*</span></label>
<input type="email" id="tc-email" name="email" required autocomplete="email" />
</div>
</div>

<div class="form-group">
<label for="tc-company">Company / Showroom <span class="required">*</span></label>
<input type="text" id="tc-company" name="company" required autocomplete="organization" />
</div>

<div class="form-row">
<div class="form-group">
<label for="tc-city">City <span class="required">*</span></label>
<input type="text" id="tc-city" name="city" required autocomplete="address-level2" />
</div>
<div class="form-group">
<label for="tc-state">State <span class="required">*</span></label>
<select id="tc-state" name="state" required>
<option value="">Select state...</option>
{states.map(([code, name]) => <option value={code}>{name}</option>)}
</select>
</div>
</div>

<div class="form-group">
<label for="tc-brand">Brand you're considering</label>
<select id="tc-brand" name="brand">
<option value="">Not sure yet — happy to talk it through</option>
{brands.map((b) => <option value={b}>{b}</option>)}
</select>
</div>

<button type="submit" class="btn-primary">See what's open</button>
<p class="form-footnote">Already know you want in? <a href="#apply">Go straight to the dealer application</a>.</p>
</form>
</div>

<h2>Who We Work With</h2>

<p>Custom shops adding a factory line. Dealers leaving a box / semi-custom program. Independent kitchen and bath showrooms, design-build firms, custom home builders, interior studios that sell product, and multi-location groups. Starting with Shiloh alone is a common first step.</p>

<h2>Dealer Guides</h2>
<p>Short answers to the questions dealers ask us most.</p>
<ul>
  <li><a href="/guides/become-a-shiloh-dealer/">Become a Shiloh dealer</a> — from custom or a box line</li>
  <li><a href="/guides/how-to-become-a-kitchen-cabinet-dealer/">How to become a kitchen cabinet dealer</a></li>
  <li><a href="/guides/protected-dealer-territories/">Protected dealer territories</a> — WW Wood West vs Pronorm nationwide</li>
  <li><a href="/guides/pronorm-american-depths/">What American depths means for Pronorm</a></li>
  <li><a href="/guides/one-showroom-six-lines/">One showroom, every tier</a></li>
  <li><a href="/guides/face-frame-vs-frameless/">Face-frame vs frameless on a dealer floor</a> — Shiloh vs Eclipse, same factory</li>
</ul>

<h2>Dealer Program FAQs</h2>
<div class="dealer-faqs">
{dealerFaqs.map((faq) => (
<div class="faq-item">
<h3>{faq.q}</h3>
<p set:html={faq.a}></p>
</div>
))}
</div>

<h2 id="apply">Apply to Become a Dealer</h2>

<p>Complete the form below. {responsePromise} On that call we cover your market, showroom, current product lines, and which Pinnacle Sales brands are the best fit for your business.</p>

<form name="dealer-application" method="POST" action="/thank-you-dealer/" data-netlify="true" netlify-honeypot="bot-field" class="dealer-form">
<input type="hidden" name="form-name" value="dealer-application" />
<input type="hidden" name="source-page" id="source-page" />
<AttributionFields />
<p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

<div class="form-group">
<label for="contact-name">Your Name <span class="required">*</span></label>
<input type="text" id="contact-name" name="name" required />
</div>

<div class="form-group">
<label for="company">Company / Showroom Name <span class="required">*</span></label>
<input type="text" id="company" name="company" required />
</div>

<div class="form-row">
<div class="form-group">
<label for="email">Email <span class="required">*</span></label>
<input type="email" id="email" name="email" required />
</div>
<div class="form-group">
<label for="phone">Phone <span class="required">*</span></label>
<input type="tel" id="phone" name="phone" required />
</div>
</div>

<div class="form-row">
<div class="form-group">
<label for="city">City <span class="required">*</span></label>
<input type="text" id="city" name="city" required />
</div>
<div class="form-group">
<label for="state">State <span class="required">*</span></label>
<select id="state" name="state" required>
<option value="">Select state...</option>
{states.map(([code, name]) => <option value={code}>{name}</option>)}
</select>
</div>
</div>

<div class="form-group">
<label for="website">Website URL</label>
<input type="url" id="website" name="website" placeholder="https://" />
</div>

<div class="form-group">
<label for="business-type">Business Type <span class="required">*</span></label>
<select id="business-type" name="business-type" required>
<option value="">Select type...</option>
<option value="Kitchen & Bath Showroom">Kitchen & Bath Showroom</option>
<option value="Design-Build Firm">Design-Build Firm</option>
<option value="Interior Design Studio">Interior Design Studio</option>
<option value="Custom Home Builder">Custom Home Builder</option>
<option value="Multi-Location Dealer">Multi-Location Dealer Group</option>
<option value="New Business / Startup">New Business / Startup</option>
<option value="Other">Other</option>
</select>
</div>

<div class="form-group">
<label for="brands-interest">Which brands are you most interested in?</label>
<div class="checkbox-group">
{brands.map((b) => <label class="checkbox-label"><input type="checkbox" name="brands-interest" value={b} /> {b}</label>)}
</div>
</div>

<div class="form-group">
<label for="current-lines">What cabinet lines do you currently carry?</label>
<textarea id="current-lines" name="current-lines" rows="3" placeholder="List your current brands and approximate annual volume if comfortable sharing..."></textarea>
</div>

<div class="form-group">
<label for="message">Anything else you'd like us to know?</label>
<textarea id="message" name="message" rows="3"></textarea>
</div>

<button type="submit" class="btn-primary">Submit Application</button>
</form>

<p style="margin-top:2rem;color:#6b7280;font-size:.9rem;">Prefer to talk first? Call <a href="tel:+14809939224">480-993-9224</a> or email <a href="mailto:marketing@pinnaclesales.biz">marketing@pinnaclesales.biz</a>.</p>

</div>

<script is:inline>
(function () {
  // Attribution: which page sent this visitor here. Both forms carry a hidden source-page field.
  var src = 'direct';
  try {
    if (document.referrer) {
      var r = new URL(document.referrer);
      if (r.host === location.host) src = r.pathname || 'direct';
    }
  } catch (e) {}
  document.querySelectorAll('input[name="source-page"]').forEach(function (el) { el.value = src; });

  // Stash lead context; the GA4 generate_lead conversion fires on the thank-you page
  // (firing on the destination page survives the form's full-page navigation).
  function stash(form, ctx) {
    form.addEventListener('submit', function () {
      if (this.elements['bot-field'] && this.elements['bot-field'].value) return; // honeypot: no conversion for spam
      try {
        var val = function (name) { var el = this.elements[name]; return el && el.value ? el.value : ''; }.bind(this);
        sessionStorage.setItem('ps_lead', JSON.stringify(Object.assign({ source: src }, ctx, {
          city: val('city'), state: val('state'), brand: val('brand')
        })));
      } catch (e) {}
    });
  }
  var application = document.querySelector('form[name="dealer-application"]');
  if (application) stash(application, { form: 'dealer-application', lead_type: 'Dealer Application' });
  var territory = document.querySelector('form[name="territory-check"]');
  if (territory) stash(territory, { form: 'territory-check', lead_type: 'Territory Check' });
})();
</script>

</BaseLayout>
<style>
.benefits-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.25rem;margin:1.5rem 0}
.benefit{border:1px solid #e5e7eb;border-radius:8px;padding:1.25rem}
.benefit h3{margin:0 0 .5rem;font-size:1.05rem;color:#1a1a2e}
.benefit p{color:#4b5563;margin:0;font-size:.95rem}
.social-proof{margin:2.5rem 0;text-align:center}
.social-proof h2{margin-bottom:1.5rem}
.stats-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:2rem}
.stat{background:#f8fafc;border-radius:10px;padding:1.25rem .75rem}
.stat-number{display:block;font-size:2rem;font-weight:700;color:#1a1a2e}
.stat-label{display:block;font-size:.85rem;color:#6b7280;margin-top:.25rem}
.testimonial{background:#f0f7ff;border-left:4px solid #2563eb;border-radius:8px;padding:1.5rem 2rem;margin:0 auto;max-width:640px;text-align:left;font-style:italic}
.testimonial p{margin:0 0 .75rem;font-size:1.05rem;color:#1e293b;line-height:1.6}
.testimonial cite{font-size:.9rem;color:#64748b;font-style:normal;font-weight:600}
@media(max-width:600px){.stats-bar{grid-template-columns:repeat(2,1fr)}}
.dealer-form{margin-top:1.5rem;max-width:640px}
.form-group{margin-bottom:1.25rem}
.form-group label{display:block;font-weight:600;margin-bottom:.4rem;font-size:.95rem;color:#1a1a2e}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:.65rem .75rem;border:1px solid #d1d5db;border-radius:6px;font-size:.95rem;font-family:inherit;background:#fff;transition:border-color .2s}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{outline:none;border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.1)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
@media(max-width:600px){.form-row{grid-template-columns:1fr}}
.checkbox-group{display:flex;flex-direction:column;gap:.5rem;margin-top:.25rem}
.checkbox-label{display:flex;align-items:center;gap:.5rem;font-weight:400;font-size:.95rem;cursor:pointer}
.checkbox-label input{width:auto;margin:0}
.required{color:#dc2626}
.hidden{display:none}
.btn-primary{background:#1a1a2e;color:#fff;border:none;padding:.75rem 2rem;border-radius:6px;font-size:1rem;font-weight:600;cursor:pointer;transition:background .2s}
.btn-primary:hover{background:#2563eb}
.header-ctas{display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap}
.header-apply{margin-top:1.5rem}
.btn-ghost{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.7)}
.btn-ghost:hover{background:rgba(255,255,255,.12);opacity:1}
.territory-check{margin:1.5rem 0 2.5rem;padding:1.5rem 1.75rem;border:1px solid #d6e2f5;border-radius:10px;background:#f5f8ff;scroll-margin-top:6rem}
.territory-check-intro h3{margin:0 0 .5rem;font-size:1.2rem;color:#1a1a2e}
.territory-check-intro p{margin:0 0 1rem;color:#4b5563;font-size:.95rem;line-height:1.6}
.territory-form{margin-top:.5rem;max-width:none}
.territory-form .form-group{margin-bottom:1rem}
.form-footnote{margin:1rem 0 0;font-size:.9rem;color:#6b7280}
@media(max-width:600px){.territory-check{padding:1.25rem 1rem}}
.dealer-faqs{margin:1.25rem 0 2rem}
.faq-item{border-bottom:1px solid #e5e7eb;padding:1.25rem 0}
.faq-item:last-child{border-bottom:none}
.faq-item h3{font-size:1.05rem;margin:0 0 .5rem;color:#1a1a2e}
.faq-item p{margin:0;color:#4b5563;font-size:.95rem;line-height:1.6}
</style>
