---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: object | object[];
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author: string;
  };
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/images/pinnacle-sales-og.jpg',
  schema,
  article,
} = Astro.props;

const siteName = 'Pinnacle Sales';
const siteUrl = 'https://www.pinnaclesales.biz';

// Global Organization schema on every page
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Pinnacle Sales",
  "url": siteUrl,
  "logo": `${siteUrl}/images/pinnacle-sales-logo.png`,
  "description": "Premium cabinetry dealer representative serving 10 Western US states. Exclusive rep for Shiloh, Eclipse, Aspect, Pronorm, and Vistora.",
  "foundingDate": "2001",
  "areaServed": ["Arizona","California","Colorado","Idaho","Montana","Nevada","New Mexico","Oregon","Utah","Washington"],
  "contactPoint": { "@type": "ContactPoint", "telephone": "+1-480-993-9224", "contactType": "sales" },
  "sameAs": ["https://www.linkedin.com/company/pinnacle-sales-kbi"]
};

const allSchemas = [orgSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!-- Google tag (gtag.js) — GA4 property pinnaclesales.biz.
     Deferred until first user interaction (or 5s timeout) so it doesn't
     block the main thread on initial page load. dataLayer + config still
     run immediately so any pre-load tracking calls queue correctly. -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-F8STEE6JZM');

  (function() {
    var GA_SRC = 'https://www.googletagmanager.com/gtag/js?id=G-F8STEE6JZM';
    var loaded = false;
    function loadGA() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = GA_SRC;
      document.head.appendChild(s);
    }
    var EVENTS = ['scroll','mousemove','mousedown','touchstart','keydown'];
    var opts = { once: true, passive: true };
    EVENTS.forEach(function(ev) { window.addEventListener(ev, loadGA, opts); });
    // Fallback: load anyway after 5 seconds, even if the user never
    // interacts, so we don't lose tracking entirely on idle tabs.
    setTimeout(loadGA, 5000);
  })();
</script>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteName} />

{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    <meta property="article:author" content={article.author} />
  </>
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

<!-- Schema.org JSON-LD -->
{allSchemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
