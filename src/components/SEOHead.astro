---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  heroImage?: string;  // LCP candidate — emits <link rel="preload"> in head
  schema?: object | object[];
  noindex?: boolean;  // utility pages (thank-you, etc.) that shouldn't rank
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author: string;
  };
}

const {
  title,
  description,
  canonical: canonicalProp,
  ogImage = '/images/pinnacle-sales-og.jpg',
  heroImage,
  schema,
  noindex = false,
  article,
} = Astro.props;

const siteName = 'Pinnacle Sales';
const siteUrl = 'https://pinnaclesales.biz';

// Brand rule: canonical is always non-www with a trailing slash.
const toCanonical = (input?: string) => {
  const raw = input || Astro.url.pathname || '/';
  let path = raw;
  try {
    if (/^https?:\/\//i.test(raw)) path = new URL(raw).pathname;
  } catch {
    path = Astro.url.pathname || '/';
  }
  if (!path.startsWith('/')) path = `/${path}`;
  if (!path.endsWith('/')) path += '/';
  return `${siteUrl}${path}`;
};
const canonical = toCanonical(canonicalProp);

// Global Organization schema on every page
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Pinnacle Sales",
  "url": siteUrl,
  "logo": `${siteUrl}/images/pinnacle-sales-logo.webp`,
  "description": "Premium cabinetry dealer representative serving 10 Western US states. Six public brands: Shiloh, Eclipse, Aspect, Vistora, Pronorm, and US Stone.",
  "foundingDate": "2001",
  "areaServed": ["Arizona","California","Colorado","Idaho","Montana","Nevada","New Mexico","Oregon","Utah","Washington"],
  "contactPoint": { "@type": "ContactPoint", "telephone": "+1-480-993-9224", "contactType": "sales" },
  "sameAs": ["https://www.linkedin.com/company/pinnacle-sales-kbi"]
};

const allSchemas = [orgSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!-- Google tag (gtag.js) — GA4 property pinnaclesales.biz.
     Deferred until first user interaction (or 5s timeout) so it doesn't
     block the main thread on initial page load. dataLayer + config still
     run immediately so any pre-load tracking calls queue correctly. -->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-F8STEE6JZM');

  (function() {
    var GA_SRC = 'https://www.googletagmanager.com/gtag/js?id=G-F8STEE6JZM';
    var loaded = false;
    function loadGA() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = GA_SRC;
      document.head.appendChild(s);
    }
    var EVENTS = ['scroll','mousemove','mousedown','touchstart','keydown'];
    var opts = { once: true, passive: true };
    EVENTS.forEach(function(ev) { window.addEventListener(ev, loadGA, opts); });
    // Fallback: load anyway after 5 seconds, even if the user never
    // interacts, so we don't lose tracking entirely on idle tabs.
    setTimeout(loadGA, 5000);
  })();
</script>

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />

{/* Preload the page's LCP hero image so the browser starts the network request
    immediately, before the HTML parser reaches the body's <img>. ~100-300ms LCP win
    on pages with a body hero. */}
{heroImage && (
  <link rel="preload" as="image" href={heroImage} fetchpriority="high" />
)}

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteName} />

{article && (
  <>
    <meta property="article:published_time" content={article.publishedTime} />
    {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
    <meta property="article:author" content={article.author} />
  </>
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

<!-- Schema.org JSON-LD -->
{allSchemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
