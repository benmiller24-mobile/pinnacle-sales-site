---
import { publishedTestimonials, type Testimonial } from '../data/testimonials';

export interface Props {
  heading?: string;
  subhead?: string;
  limit?: number;
  /** Show all published testimonials, or only those marked featured */
  featuredOnly?: boolean;
}

const {
  heading = 'What Pinnacle Sales Dealers Say',
  subhead = 'Direct quotes from showrooms in our 10-state Western US territory.',
  limit = 3,
  featuredOnly = false,
} = Astro.props;

const list: Testimonial[] = (featuredOnly
  ? publishedTestimonials.filter(t => t.featured)
  : publishedTestimonials
).slice(0, limit);

if (list.length === 0) {
  // Render nothing if no published testimonials yet — the section is
  // wired in but stays out of the DOM until real quotes are added.
}
---

{list.length > 0 && (
<section class="testimonials">
  <div class="testimonials-inner">
    <header class="testimonials-header">
      <h2>{heading}</h2>
      {subhead && <p>{subhead}</p>}
    </header>
    <div class={`testimonials-grid count-${list.length}`}>
      {list.map((t) => (
        <figure class="testimonial-card">
          <blockquote class="testimonial-quote">
            <p>&ldquo;{t.quote}&rdquo;</p>
          </blockquote>
          <figcaption class="testimonial-attrib">
            {t.photo && (
              <img src={t.photo} alt={t.name} loading="lazy" class="testimonial-avatar" width="56" height="56" />
            )}
            <div>
              <div class="testimonial-name">{t.name}{t.role && <span class="testimonial-role">, {t.role}</span>}</div>
              <div class="testimonial-org">{t.dealership}{t.location && <> &middot; {t.location}</>}</div>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
)}

<style>
  .testimonials {
    background: var(--color-bg-warm, #faf8f5);
    padding: 4rem 2rem;
  }
  .testimonials-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .testimonials-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .testimonials-header h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 400;
    margin: 0 0 0.6rem;
  }
  .testimonials-header p {
    color: var(--color-muted, #666);
    max-width: 560px;
    margin: 0 auto;
  }
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .testimonials-grid.count-1 { max-width: 720px; margin: 0 auto; }
  .testimonials-grid.count-2 { grid-template-columns: repeat(2, minmax(280px, 1fr)); }
  .testimonial-card {
    background: #fff;
    border: 1px solid var(--color-border, #e0e0e0);
    padding: 2rem 1.75rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .testimonial-quote { margin: 0; }
  .testimonial-quote p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-body, #333);
    margin: 0;
  }
  .testimonial-attrib {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    border-top: 1px solid var(--color-border, #e0e0e0);
    padding-top: 1rem;
    margin: 0;
  }
  .testimonial-avatar {
    width: 56px; height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex: 0 0 auto;
  }
  .testimonial-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-body, #333);
  }
  .testimonial-role {
    font-weight: 400;
    color: var(--color-muted, #666);
  }
  .testimonial-org {
    font-size: 0.78rem;
    color: var(--color-light-text, #999);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 0.15rem;
  }
  @media (max-width: 720px) {
    .testimonials-grid.count-2 { grid-template-columns: 1fr; }
  }
</style>
