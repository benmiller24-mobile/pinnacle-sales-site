---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';

export interface Props {
  title: string;
  description?: string;
  activeSection?: string;
}

const { title, description = 'Pinnacle Sales Dealer Hub — resources, training, and support for authorized dealers.', activeSection } = Astro.props;

const navItems = [
  { href: '/dealer-hub/dashboard', label: 'Dashboard', icon: '◻' },
  { href: '/dealer-hub/activation', label: 'Activation Plan', icon: '🚀' },
  { href: '/dealer-hub/onboarding', label: 'Onboarding', icon: '✓' },
  { href: '/dealer-hub/designer-onboarding', label: 'Designer Onboarding', icon: '✏' },
  { href: '/dealer-hub/ordering', label: 'Ordering SOPs', icon: '📋' },
  { href: '/dealer-hub/order-samples', label: 'Order Samples', icon: '🪟' },
  { href: '/dealer-hub/training', label: 'Training', icon: '🎓' },
  { href: '/dealer-hub/marketing', label: 'Marketing Kit', icon: '📣' },
  { href: '/dealer-hub/showroom', label: 'Showroom Standards', icon: '🏠' },
  { href: '/dealer-hub/videos', label: 'Video Library', icon: '🎬' },
  { href: '/dealer-hub/downloads', label: 'Downloads & Forms', icon: '📥' },
  { href: '/dealer-hub/faq', label: 'FAQ', icon: '❓' },
  { href: '/dealer-hub/support', label: 'Support & Escalation', icon: '🔧' },
  { href: '/dealer-hub/submit', label: 'Submit Request', icon: '📨' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <SEOHead title={title} description={description} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
