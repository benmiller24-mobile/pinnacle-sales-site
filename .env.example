# Copy to .env for local runs of the dealer-lead function (netlify dev / node --env-file).
# Production values live in Netlify → Site configuration → Environment variables.

# --- HubSpot (private app, CRM contacts/companies/deals read+write) ---
HUBSPOT_PRIVATE_APP_TOKEN=
# HUBSPOT_BCC_ADDRESS=244107450@bcc.na2.hubspot.com

# --- Outbound mail (Google Workspace mailbox + app password) ---
